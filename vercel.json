{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/hidden-china-atlas",
      "destination": "https://hidden-china-atlas.vercel.app/hidden-china-atlas"
    },
    {
      "source": "/hidden-china-atlas/:path*",
      "destination": "https://hidden-china-atlas.vercel.app/hidden-china-atlas/:path*"
    },

    {
      "source": "/release-panic-room",
      "destination": "https://release-panic-room.vercel.app/release-panic-room"
    },
    {
      "source": "/release-panic-room/:path*",
      "destination": "https://release-panic-room.vercel.app/release-panic-room/:path*"
    },

    {
      "source": "/rateministere",
      "destination": "https://rateministere.vercel.app/rateministere"
    },
    {
      "source": "/rateministere/:path*",
      "destination": "https://rateministere.vercel.app/rateministere/:path*"
    }
  ]
}